#!/usr/bin/env bash
# Regenerates every derived app icon from crates/bgpaint/assets/icon.svg:
# icon-{16..1024}.png and icon.ico (PNG frames 16-256), where the tile fills the
# canvas, and icon.icns (icp4/icp5/icp6/ic07-ic14) from icon-macos.svg, which adds
# Apple's transparent margin. Needs rsvg-convert and python3; adds nothing to
# the workspace build. Run script/generate-macos-dmg-assets afterwards (the DMG
# volume icon carries the app icon).
set -euo pipefail

dir="$(cd "$(dirname "$0")/.." && pwd)/crates/bgpaint/assets"
command -v rsvg-convert >/dev/null || { echo "rsvg-convert is required (brew install librsvg)" >&2; exit 1; }

for size in 16 24 32 48 64 128 256 512 1024; do
  rsvg-convert --width "$size" --height "$size" --output "$dir/icon-$size.png" "$dir/icon.svg"
done
mac="$(mktemp -d)"
trap 'rm -rf "$mac"' EXIT
for size in 16 32 64 128 256 512 1024; do
  rsvg-convert --width "$size" --height "$size" --output "$mac/icon-$size.png" "$dir/icon-macos.svg"
done

python3 -I - "$dir" "$mac" <<'PY'
import struct, sys
from pathlib import Path

d, mac = Path(sys.argv[1]), Path(sys.argv[2])
png = lambda size: (d / f"icon-{size}.png").read_bytes()

# ICO: 6-byte header, 16-byte entries, then PNG frames (256 is stored as 0).
sizes = (16, 24, 32, 48, 64, 128, 256)
frames = [png(s) for s in sizes]
offset = 6 + 16 * len(sizes)
head = struct.pack("<HHH", 0, 1, len(sizes))
for size, data in zip(sizes, frames):
    edge = size % 256
    head += struct.pack("<BBBBHHII", edge, edge, 0, 0, 1, 32, len(data), offset)
    offset += len(data)
(d / "icon.ico").write_bytes(head + b"".join(frames))

# ICNS (with the macOS margin): retina types reuse the doubled PNG.
png = lambda size: (mac / f"icon-{size}.png").read_bytes()
types = ((b"icp4", 16), (b"icp5", 32), (b"icp6", 64), (b"ic07", 128),
         (b"ic08", 256), (b"ic09", 512), (b"ic10", 1024), (b"ic11", 32),
         (b"ic12", 64), (b"ic13", 256), (b"ic14", 512))
body = b"".join(t + struct.pack(">I", 8 + len(png(s))) + png(s) for t, s in types)
(d / "icon.icns").write_bytes(b"icns" + struct.pack(">I", 8 + len(body)) + body)
PY
echo "Regenerated app icons in $dir"
